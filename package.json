{
  "name": "toctoc-auth",
  "version": "1.1.9",
  "description": "A simple auth library made for backend meatheads.",
  "keywords": [
    "auth",
    "react",
    "jwt",
    "authentication",
    "authorization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LibardiFelipe/toctoc-auth"
  },
  "license": "MIT",
  "author": "Felipe Libardi Gonçalves",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts && copy README.md dist\\",
    "prepublishOnly": "npm run build",
    "test": "tsup tests/*.test.ts --format cjs --target node18 --out-dir dist/tests && node --test dist/tests/*.test.js",
    "test:browser": "esbuild tests/browser/fixture.ts --bundle --platform=browser --format=iife --global-name=fixture --outfile=dist/tests/browser-fixture.js && node --test tests/browser/refresh.cjs"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "crypto-js": "^4.2.0",
    "csstype": "^3.1.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.1.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.7",
    "playwright": "^1.65.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
